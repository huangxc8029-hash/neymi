# A01 has no external providers and requires no secrets.
# Add provider settings only when their adapters are implemented.
# Generate a random value of at least 32 bytes before enabling cloud endpoints.
NEYMI_SESSION_SECRET=
# Separate stable random secret for deriving publication revoke tokens.
NEYMI_PUBLICATION_SECRET=
# Configure your platform scheduler to POST /v1/maintenance/cleanup with this bearer secret.
NEYMI_CLEANUP_SECRET=
# Mount this path on persistent storage before enabling cloud jobs.
NEYMI_SQLITE_PATH=./.data/neymi.sqlite
# Optional live providers. Keep keys in the server environment; do not commit them.
NEYMI_DEEPSEEK_API_KEY=
# Defaults to deepseek-flash when omitted.
NEYMI_DEEPSEEK_MODEL=deepseek-flash
NEYMI_TAVILY_API_KEY=
# Optional account sign-in. Never add a Supabase service-role key to NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Show OAuth buttons only after configuring the matching provider in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# Canonical public card URLs and social preview images.
NEYMI_PUBLIC_ORIGIN=https://swtpic.com
# For Vercel/serverless, use the Supabase/Postgres adapter instead of SQLite.
# Before switching, apply docs/sql/neymi_publications.sql and migrate live records.
# NEYMI_PUBLICATION_STORAGE=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
