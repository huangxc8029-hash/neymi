{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-neymi/types/**/*.ts",
    ".next-neymi/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-visual-v12/types/**/*.ts",
    ".next-visual-v12/dev/types/**/*.ts",
    ".next-card-design/types/**/*.ts",
    ".next-card-design/dev/types/**/*.ts",
    ".next-local-preview/types/**/*.ts",
    ".next-local-preview/dev/types/**/*.ts",
    ".next-redesign-preview/types/**/*.ts",
    ".next-redesign-preview/dev/types/**/*.ts",
    ".next-card-final/types/**/*.ts",
    ".next-card-final/dev/types/**/*.ts",
    ".next-local-preview/types/**/*.ts",
    ".next-local-preview/dev/types/**/*.ts",
    ".next-redesign-preview/types/**/*.ts",
    ".next-redesign-preview/dev/types/**/*.ts",
    ".next-live-show/types/**/*.ts",
    ".next-live-show/dev/types/**/*.ts",
    ".next-quick-share/types/**/*.ts",
    ".next-quick-share/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
